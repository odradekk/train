<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Train</RootNamespace>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Core/Train.Core.csproj" />
    <ProjectReference Include="Content/Train.Content.csproj" />
    <ProjectReference Include="Scenes/Train.Scenes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Train.Godot.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Contracts/**" />
    <EmbeddedResource Remove="Contracts/**" />
    <None Remove="Contracts/**" />
    <Compile Remove="prototypes/**" />
    <EmbeddedResource Remove="prototypes/**" />
    <None Remove="prototypes/**" />
    <Compile Remove="Core/**" />
    <EmbeddedResource Remove="Core/**" />
    <None Remove="Core/**" />
    <Compile Remove="Content/**" />
    <EmbeddedResource Remove="Content/**" />
    <None Remove="Content/**" />
    <Compile Remove="Scenes/**" />
    <EmbeddedResource Remove="Scenes/**" />
    <None Remove="Scenes/**" />
    <Compile Remove="archive/**" />
    <EmbeddedResource Remove="archive/**" />
    <None Remove="archive/**" />
    <Compile Remove="Train.Tests/**" />
    <EmbeddedResource Remove="Train.Tests/**" />
    <None Remove="Train.Tests/**" />
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
    <Compile Remove="TestResults/**" />
    <EmbeddedResource Remove="TestResults/**" />
    <None Remove="TestResults/**" />
    <Compile Remove="scripts/metadata-reader/**" />
    <EmbeddedResource Remove="scripts/metadata-reader/**" />
    <None Remove="scripts/metadata-reader/**" />
  </ItemGroup>
</Project>
