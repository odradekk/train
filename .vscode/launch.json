{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train (Godot)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:GODOT_EDITOR}",
            "args": ["--path", "${workspaceFolder}"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
