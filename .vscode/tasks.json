{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Train.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Train.Tests/Train.Tests.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "export-windows",
            "command": "pwsh",
            "type": "process",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/run-godot-content-export-smoke.ps1",
                "-ExportOnly",
                "-OutputPath",
                "${workspaceFolder}/builds/windows/train.exe"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
