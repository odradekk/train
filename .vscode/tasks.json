{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Train.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "pwsh",
            "type": "process",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/test.ps1",
                "-Layer",
                "fast"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "export-windows",
            "command": "pwsh",
            "type": "process",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/test.ps1",
                "-Layer",
                "engine",
                "-ExportWindows"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
