{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Train.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "pwsh",
            "type": "process",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/run-tests.ps1",
                "-Family",
                "unit"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "export-windows",
            "command": "pwsh",
            "type": "process",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/run-tests.ps1",
                "-Test",
                "godot.content-export-smoke",
                "-Test",
                "godot.mods-export-smoke"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
