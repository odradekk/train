#!/usr/bin/env bash
# Install the locked .NET SDK, PowerShell 7, and Godot .NET so orb agents can
# restore, test, and run Linux Godot validation without re-downloading.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

DOTNET_SDK_VERSION="10.0.112"
DOTNET_SDK_URL="https://builds.dotnet.microsoft.com/dotnet/Sdk/${DOTNET_SDK_VERSION}/dotnet-sdk-${DOTNET_SDK_VERSION}-linux-x64.tar.gz"
DOTNET_SDK_SHA512="1ac949dfd3929855e3a102a5b12f843967a784ad2d911dfcfff6abdf81a2e78bccf25ddc055547de02b36133bf792aaf97fcba8db8aa6b52ac2e018b86935d05"
DOTNET_ROOT="${HOME}/.dotnet"

PWSH_DEB_VERSION="7.6.5"
PWSH_DEB_URL="https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_DEB_VERSION}/powershell_${PWSH_DEB_VERSION}-1.deb_amd64.deb"
PWSH_DEB_SHA256="dd683d29a5c95ed43e426f4fe1679469d8b89e78ea955455f6238a0b0e6f1a24"

GODOT_VERSION="4.7.2"
GODOT_ZIP_NAME="Godot_v${GODOT_VERSION}-stable_mono_linux_x86_64.zip"
GODOT_URL="https://github.com/godotengine/godot-builds/releases/download/${GODOT_VERSION}-stable/${GODOT_ZIP_NAME}"
GODOT_SHA512="1855960b27ee3ef5e66e5e228cced69d55637b24334a7411162687dcd077d8f9f645348cdb8eae984bec8135d49ed855a1e3a16476786b8bce60774fd8402d13"
GODOT_HOME="${HOME}/.local/share/godot/${GODOT_VERSION}.stable.mono"
GODOT_BIN="${GODOT_HOME}/Godot_v${GODOT_VERSION}-stable_mono_linux.x86_64"

CACHE_DIR="${HOME}/.cache/train-orb"
PROFILE_SNIPPET_FILE="${HOME}/.config/train-orb/env.sh"
PROFILE_MARKER="# train-orb toolchain"

step() {
  local label="$1"
  shift
  echo "==> ${label}"
  local start
  start="$(date +%s)"
  "$@"
  echo "    done in $(( $(date +%s) - start ))s"
}

need_packages() {
  local missing=()
  local pkg
  for pkg in "$@"; do
    if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
      missing+=("$pkg")
    fi
  done
  if ((${#missing[@]} == 0)); then
    echo "system packages already installed"
    return 0
  fi
  echo "installing: ${missing[*]}"
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
}

download_verified() {
  local url="$1"
  local dest="$2"
  local algo="$3"
  local expected="$4"
  if [[ -f "$dest" ]]; then
    local actual
    actual="$("sha${algo}sum" "$dest" | awk '{print $1}')"
    if [[ "$actual" == "$expected" ]]; then
      echo "cache hit $(basename "$dest")"
      return 0
    fi
    echo "stale cache $(basename "$dest"), redownloading"
    rm -f "$dest"
  fi
  curl -fsSL --retry 3 --retry-delay 2 -o "$dest" "$url"
  local actual
  actual="$("sha${algo}sum" "$dest" | awk '{print $1}')"
  if [[ "$actual" != "$expected" ]]; then
    echo "checksum mismatch for $(basename "$dest")" >&2
    echo "expected ${expected}" >&2
    echo "actual   ${actual}" >&2
    rm -f "$dest"
    return 1
  fi
}

ensure_profile_hook() {
  local file="$1"
  touch "$file"
  if grep -Fqx "$PROFILE_MARKER" "$file"; then
    return 0
  fi
  cat >> "$file" <<EOF

${PROFILE_MARKER}
if [ -f "${PROFILE_SNIPPET_FILE}" ]; then
  . "${PROFILE_SNIPPET_FILE}"
fi
EOF
}

write_profile_snippet() {
  mkdir -p "$(dirname "$PROFILE_SNIPPET_FILE")"
  cat > "$PROFILE_SNIPPET_FILE" <<EOF
# Generated by .agents/setup. Safe to re-run.
export DOTNET_ROOT="${DOTNET_ROOT}"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export NUGET_PACKAGES="\${NUGET_PACKAGES:-${HOME}/.nuget/packages}"
export GODOT_HOME="${GODOT_HOME}"
export GODOT="${GODOT_BIN}"
export GODOT_EDITOR="${GODOT_BIN}"
case ":\${PATH}:" in
  *:${DOTNET_ROOT}:*) ;;
  *) export PATH="${DOTNET_ROOT}:${DOTNET_ROOT}/tools:\${PATH}" ;;
esac
case ":\${PATH}:" in
  *:${HOME}/.local/bin:*) ;;
  *) export PATH="${HOME}/.local/bin:\${PATH}" ;;
esac
EOF
  chmod 644 "$PROFILE_SNIPPET_FILE"
  ensure_profile_hook "${HOME}/.bash_profile"
  ensure_profile_hook "${HOME}/.profile"
}

install_dotnet() {
  mkdir -p "$DOTNET_ROOT" "$CACHE_DIR"
  if [[ -x "${DOTNET_ROOT}/dotnet" ]] && "${DOTNET_ROOT}/dotnet" --list-sdks 2>/dev/null | grep -Fq "${DOTNET_SDK_VERSION} "; then
    echo ".NET SDK ${DOTNET_SDK_VERSION} already installed"
    return 0
  fi
  local tarball="${CACHE_DIR}/dotnet-sdk-${DOTNET_SDK_VERSION}-linux-x64.tar.gz"
  download_verified "$DOTNET_SDK_URL" "$tarball" 512 "$DOTNET_SDK_SHA512"
  tar -xzf "$tarball" -C "$DOTNET_ROOT"
  "${DOTNET_ROOT}/dotnet" --list-sdks | grep -Fq "${DOTNET_SDK_VERSION} "
}

install_pwsh() {
  if command -v pwsh >/dev/null 2>&1; then
    echo "pwsh already installed: $(command -v pwsh)"
    return 0
  fi
  mkdir -p "$CACHE_DIR"
  local deb="${CACHE_DIR}/powershell_${PWSH_DEB_VERSION}-1.deb_amd64.deb"
  download_verified "$PWSH_DEB_URL" "$deb" 256 "$PWSH_DEB_SHA256"
  sudo dpkg -i "$deb" || sudo apt-get install -f -y
  command -v pwsh >/dev/null
}

flatten_godot_tree() {
  if [[ -x "$GODOT_BIN" ]]; then
    return 0
  fi
  local extracted=""
  local candidate
  while IFS= read -r candidate; do
    extracted="$candidate"
    break
  done < <(find "$GODOT_HOME" -maxdepth 3 -type f -name 'Godot_v*_mono_linux.x86_64' -print)
  if [[ -z "$extracted" ]]; then
    echo "Godot binary missing after unzip" >&2
    find "$GODOT_HOME" -maxdepth 3 -print >&2 || true
    return 1
  fi
  local extracted_dir
  extracted_dir="$(dirname "$extracted")"
  if [[ "$extracted_dir" != "$GODOT_HOME" ]]; then
    shopt -s dotglob
    mv "$extracted_dir"/* "$GODOT_HOME"/
    shopt -u dotglob
    rmdir "$extracted_dir" 2>/dev/null || true
  fi
}

install_godot() {
  mkdir -p "${HOME}/.local/bin" "$CACHE_DIR" "$(dirname "$GODOT_HOME")"
  if [[ -x "$GODOT_BIN" ]]; then
    echo "Godot already installed at ${GODOT_BIN}"
  else
    local zip="${CACHE_DIR}/${GODOT_ZIP_NAME}"
    download_verified "$GODOT_URL" "$zip" 512 "$GODOT_SHA512"
    rm -rf "$GODOT_HOME"
    mkdir -p "$GODOT_HOME"
    unzip -q "$zip" -d "$GODOT_HOME"
    flatten_godot_tree
    chmod +x "$GODOT_BIN"
  fi
  ln -sfn "$GODOT_BIN" "${HOME}/.local/bin/godot-dotnet"
  ln -sfn "$GODOT_BIN" "${HOME}/.local/bin/godot"
  test -x "$GODOT_BIN"
}

restore_and_build() {
  export DOTNET_ROOT
  export PATH="${DOTNET_ROOT}:${DOTNET_ROOT}/tools:${HOME}/.local/bin:${PATH}"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export GODOT="$GODOT_BIN"
  export GODOT_EDITOR="$GODOT_BIN"
  export GODOT_HOME
  dotnet restore Train.sln --verbosity minimal
  dotnet build Train.sln --no-restore --verbosity minimal
}

write_agent_notes() {
  local notes="${HOME}/.config/amp/AGENTS.md"
  mkdir -p "$(dirname "$notes")"
  python3 - "$notes" "$DOTNET_SDK_VERSION" "$GODOT_VERSION" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
sdk = sys.argv[2]
godot = sys.argv[3]
start = "<!-- train-orb-setup -->"
end = "<!-- /train-orb-setup -->"
block = f"""{start}
# Train orb toolchain

This orb already has the repository's locked Linux toolchain:

- .NET SDK `{sdk}` at `$HOME/.dotnet` (`global.json` roll-forward is disabled)
- PowerShell 7 (`pwsh`)
- Godot {godot} .NET at `$GODOT` / `godot-dotnet`

Login shells source `~/.config/train-orb/env.sh`. Restore and test without extra PATH work:

```bash
dotnet --version
"$GODOT" --headless --version
pwsh -NoProfile -File scripts/test.ps1 -Layer all
```

The unified test entry has not yet been validated on Linux; see [#407](https://github.com/odradekk/train/issues/407).

Windows export/runtime validation is not available in this Debian orb.
{end}
"""
text = path.read_text() if path.exists() else ""
if start in text and end in text:
    before, rest = text.split(start, 1)
    _, after = rest.split(end, 1)
    path.write_text(before + block + after)
else:
    prefix = text.rstrip()
    path.write_text((prefix + "\n\n" if prefix else "") + block + "\n")
PY
}

step "install system packages" need_packages \
  ca-certificates \
  curl \
  unzip \
  tar \
  libicu72 \
  libx11-6 \
  libxcursor1 \
  libxi6 \
  libxinerama1 \
  libxrandr2 \
  libxrender1 \
  libxkbcommon0 \
  libgl1 \
  libglu1-mesa \
  libfontconfig1 \
  libasound2 \
  libdbus-1-3

step "install .NET SDK ${DOTNET_SDK_VERSION}" install_dotnet
step "install PowerShell ${PWSH_DEB_VERSION}" install_pwsh
step "install Godot ${GODOT_VERSION} .NET" install_godot
step "write login-shell toolchain env" write_profile_snippet
step "restore and build Train.sln" restore_and_build
step "write orb agent notes" write_agent_notes

echo "setup complete"
export PATH="${DOTNET_ROOT}:${DOTNET_ROOT}/tools:${HOME}/.local/bin:${PATH}"
dotnet --version
pwsh --version
"$GODOT_BIN" --headless --version
