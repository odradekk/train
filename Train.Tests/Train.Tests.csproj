<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Train.Tests</RootNamespace>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Domain\Behaviors\*.cs" Link="Domain\Behaviors\%(Filename)%(Extension)" />
    <Compile Include="..\Domain\Settlements\*.cs" Link="Domain\Settlements\%(Filename)%(Extension)" />
    <Compile Include="..\Domain\Composites\*.cs" Link="Domain\Composites\%(Filename)%(Extension)" />
    <Compile Include="..\Domain\Rails\*.cs" Link="Domain\Rails\%(Filename)%(Extension)" />
    <Compile Include="..\Domain\Simulation\*.cs" Link="Domain\Simulation\%(Filename)%(Extension)" />
    <Compile Include="..\Domain\Voxels\*.cs" Link="Domain\Voxels\%(Filename)%(Extension)" />
    <Compile Include="..\Content\*.cs" Link="Content\%(Filename)%(Extension)" />
    <Compile Include="..\Logging\LogEvent.cs" Link="Logging\LogEvent.cs" />
    <Compile Include="..\Logging\LogSinks.cs" Link="Logging\LogSinks.cs" />
    <Compile Include="..\Logging\TrainLogger.cs" Link="Logging\TrainLogger.cs" />
    <Compile Include="..\Console\*.cs" Link="Console\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
