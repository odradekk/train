<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TrainMvp.Tests</RootNamespace>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Domain\*.cs" Link="Domain\%(Filename)%(Extension)" />
    <Compile Include="..\Domain\Scenario\*.cs" Link="Domain\Scenario\%(Filename)%(Extension)" />
    <Compile Include="..\Domain\Definitions\*.cs" Link="Domain\Definitions\%(Filename)%(Extension)" />
    <Compile Include="..\App\GameSession.cs" Link="App\GameSession.cs" />
  </ItemGroup>
</Project>
