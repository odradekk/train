<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.23" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageDownload Include="dotnet-gcdump" Version="[10.0.750501]" />
    <Reference Include="dotnet-gcdump">
      <HintPath>$(NuGetPackageRoot)dotnet-gcdump/10.0.750501/tools/net8.0/any/dotnet-gcdump.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
