{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "simulation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/localId"
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs",
        "consumption_goods",
        "labor_ratio",
        "consumption_interval_ticks",
        "statistics_period_ticks",
        "base_growth_per_second",
        "improvement_growth_per_second",
        "maximum_loss_per_second"
      ],
      "properties": {
        "needs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "food",
            "clothing",
            "improved_diet",
            "consumer_goods",
            "consumer_electronics",
            "medical_supplies"
          ],
          "properties": {
            "food": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class",
                "amount_per_person_second",
                "weight"
              ],
              "properties": {
                "class": {
                  "const": "basic"
                },
                "amount_per_person_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "clothing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class",
                "amount_per_person_second",
                "weight"
              ],
              "properties": {
                "class": {
                  "const": "basic"
                },
                "amount_per_person_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "improved_diet": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class",
                "amount_per_person_second",
                "weight"
              ],
              "properties": {
                "class": {
                  "const": "improvement"
                },
                "amount_per_person_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "consumer_goods": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class",
                "amount_per_person_second",
                "weight"
              ],
              "properties": {
                "class": {
                  "const": "improvement"
                },
                "amount_per_person_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "consumer_electronics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class",
                "amount_per_person_second",
                "weight"
              ],
              "properties": {
                "class": {
                  "const": "improvement"
                },
                "amount_per_person_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "medical_supplies": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class",
                "amount_per_person_second",
                "weight"
              ],
              "properties": {
                "class": {
                  "const": "improvement"
                },
                "amount_per_person_second": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        "consumption_goods": {
          "type": "array",
          "minItems": 6,
        "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "good",
              "satisfies",
              "selection_order"
            ],
            "properties": {
              "good": {
                "$ref": "common.schema.json#/$defs/definitionRef"
              },
              "satisfies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "need",
                    "amount_per_good_unit"
                  ],
                  "properties": {
                    "need": {
                      "enum": [
                        "food",
                        "clothing",
                        "improved_diet",
                        "consumer_goods",
                        "consumer_electronics",
                        "medical_supplies"
                      ]
                    },
                    "amount_per_good_unit": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              "selection_order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          }
        },
        "labor_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "consumption_interval_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "statistics_period_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "base_growth_per_second": {
          "type": "number",
          "minimum": 0
        },
        "improvement_growth_per_second": {
          "type": "number",
          "minimum": 0
        },
        "maximum_loss_per_second": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/population-rule.schema.json",
  "title": "population rule",
  "description": "字段说明见 docs/content/population-rule.md。"
}
