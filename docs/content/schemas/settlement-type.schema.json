{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/settlement-type.schema.json",
  "title": "聚居地类型（<local id>.settlement-type.json）",
  "description": "字段说明见 docs/content/settlement-type.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "simulation",
    "display"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "$ref": "common.schema.json#/$defs/localId"
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight",
        "population_min",
        "population_max"
      ],
      "properties": {
        "preferred_terrain": {
          "description": "完整的地貌类型标识，空数组表示不限。",
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}:[a-z0-9][a-z0-9_-]{0,63}$"
          }
        },
        "weight": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "population_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "population_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "map_symbol"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/description"
        },
        "map_symbol": {
          "$ref": "common.schema.json#/$defs/pngPath"
        },
        "major": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
