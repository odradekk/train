{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "simulation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/localId"
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basic_reserve_hours",
        "production_reserve_hours",
        "improvement_reserve_hours",
        "default_goods_prices",
        "good_prices",
        "vehicle_buy_multiplier_basis_points",
        "vehicle_sell_multiplier_basis_points",
        "vehicle_purchase_limits",
        "automatic_evaluation_interval_ticks",
        "recent_report_limit",
        "commission_money_per_work",
        "rent_money_per_capacity_hour",
        "rentable_capacity_ratio_basis_points",
        "lease_duration_ticks"
      ],
      "properties": {
        "basic_reserve_hours": {
          "type": "number",
          "minimum": 0
        },
        "production_reserve_hours": {
          "type": "number",
          "minimum": 0
        },
        "improvement_reserve_hours": {
          "type": "number",
          "minimum": 0
        },
        "default_goods_prices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sensitivity_basis_points",
            "minimum_multiplier_basis_points",
            "maximum_multiplier_basis_points",
            "spread_basis_points"
          ],
          "properties": {
            "sensitivity_basis_points": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "minimum_multiplier_basis_points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maximum_multiplier_basis_points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "spread_basis_points": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            }
          }
        },
        "good_prices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "good",
              "parameters"
            ],
            "properties": {
              "good": {
                "$ref": "common.schema.json#/$defs/definitionRef"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sensitivity_basis_points",
                  "minimum_multiplier_basis_points",
                  "maximum_multiplier_basis_points",
                  "spread_basis_points"
                ],
                "properties": {
                  "sensitivity_basis_points": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "minimum_multiplier_basis_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "maximum_multiplier_basis_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "spread_basis_points": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  }
                }
              }
            }
          }
        },
        "vehicle_buy_multiplier_basis_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "vehicle_sell_multiplier_basis_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "vehicle_purchase_limits": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "size",
              "maximum_for_sale"
            ],
            "properties": {
              "size": {
                "$ref": "common.schema.json#/$defs/sizeClass"
              },
              "maximum_for_sale": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          }
        },
        "automatic_evaluation_interval_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "recent_report_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "commission_money_per_work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rent_money_per_capacity_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rentable_capacity_ratio_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "lease_duration_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/market-rule.schema.json",
  "title": "market rule",
  "description": "字段说明见 docs/content/market-rule.md。"
}
