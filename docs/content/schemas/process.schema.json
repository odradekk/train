{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/process.schema.json",
  "title": "流程（<local id>.process.json）",
  "description": "字段说明见 docs/content/process.md。Schema 只检查单个文件的结构；id 与文件名一致、引用存在、引用的是货物、同一数组内货物不重复等由加载器检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "simulation", "display"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/localId" },
    "simulation": { "$ref": "#/$defs/simulation" },
    "display": { "$ref": "#/$defs/display" }
  },
  "$defs": {
    "good": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voxel", "quantity"],
      "properties": {
        "voxel": { "$ref": "common.schema.json#/$defs/definitionRef" },
        "quantity": { "$ref": "common.schema.json#/$defs/positiveInt" }
      }
    },
    "goods": {
      "type": "array",
      "items": { "$ref": "#/$defs/good" }
    },
    "nonEmptyGoods": {
      "$ref": "#/$defs/goods",
      "minItems": 1
    },
    "simulation": {
      "description": "核心模拟层读取的一节。",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "work_required", "power_per_work", "labor_per_work", "facility_tag"],
      "properties": {
        "kind": { "enum": ["production", "extraction", "recovery"] },
        "inputs": { "$ref": "#/$defs/goods" },
        "outputs": { "$ref": "#/$defs/goods" },
        "extracts": { "$ref": "#/$defs/good" },
        "work_required": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "power_per_work": { "type": "number", "minimum": 0 },
        "labor_per_work": { "type": "number", "minimum": 0 },
        "facility_tag": { "$ref": "common.schema.json#/$defs/facilityTag" },
        "environment": { "$ref": "#/$defs/environment" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "production" } } },
          "then": {
            "required": ["outputs"],
            "properties": { "outputs": { "$ref": "#/$defs/nonEmptyGoods" } },
            "not": { "required": ["extracts"] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "extraction" } } },
          "then": {
            "required": ["extracts"],
            "allOf": [
              { "not": { "required": ["inputs"] } },
              { "not": { "required": ["outputs"] } }
            ]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "recovery" } } },
          "then": {
            "required": ["inputs", "outputs"],
            "properties": {
              "inputs": { "$ref": "#/$defs/nonEmptyGoods" },
              "outputs": { "$ref": "#/$defs/nonEmptyGoods" }
            },
            "not": { "required": ["extracts"] }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terrain_types"],
      "properties": {
        "terrain_types": {
          "description": "允许的地貌类型；节点的地貌类型是其中之一才满足。",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/definitionRef" }
        }
      }
    },
    "display": {
      "description": "界面读取的一节。",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "description": { "$ref": "common.schema.json#/$defs/description" }
      }
    }
  }
}
