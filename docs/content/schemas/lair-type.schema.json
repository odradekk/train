{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/lair-type.schema.json",
  "title": "lair-type",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display",
    "generation_weight",
    "members",
    "maximum_members",
    "spawn_interval_seconds",
    "raid_interval_seconds",
    "roaming_radius_hops",
    "raid_radius_hops",
    "rail_damage_work_seconds",
    "clearance_reward",
    "scene_model"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/localId"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "description": { "$ref": "common.schema.json#/$defs/description" }
      }
    },
    "generation_weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "creature",
          "weight"
        ],
        "properties": {
          "creature": {
            "$ref": "common.schema.json#/$defs/definitionRef"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "minItems": 1
    },
    "maximum_members": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "spawn_interval_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "raid_interval_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "roaming_radius_hops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "raid_radius_hops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "rail_damage_work_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "clearance_reward": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "scene_model": {
      "$ref": "common.schema.json#/$defs/definitionRef"
    }
  }
}
