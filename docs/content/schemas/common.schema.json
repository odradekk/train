{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/common.schema.json",
  "title": "内容定义共用的类型",
  "$defs": {
    "localId": {
      "description": "local id：1–64 个字符，只用小写英文字母、数字、下划线和连字符，以字母或数字开头；不能是 shared，它是共用资产文件夹的名字。",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "not": { "const": "shared" }
    },
    "definitionRef": {
      "description": "对另一份内容定义的引用：同一个包里写 local id，其他包写 `<命名空间>:<local id>`；命名空间是 `core` 或包的 UUID。写本包的命名空间也可以，等同 local id。",
      "type": "string",
      "pattern": "^((core|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}):)?[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "uuid": {
      "description": "小写、带连字符的 UUID。",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "semver": {
      "description": "SemVer 2.0 版本号。",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "pngPath": {
      "description": "PNG 资产路径。不带斜杠的文件名指定义自己的同名文件夹；以 `shared/` 开头的指同类定义共用的文件夹。",
      "type": "string",
      "pattern": "^(shared/)?[a-z0-9][a-z0-9_-]*\\.png$"
    },
    "glbPath": {
      "description": "glTF 二进制模型路径，规则同 pngPath。模型文件的约定见 voxel.md。",
      "type": "string",
      "pattern": "^(shared/)?[a-z0-9][a-z0-9_-]*\\.glb$"
    },
    "name": { "description": "显示名称，去掉首尾空白后 1–100 个字符。", "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "description": "说明，去掉首尾空白后 1–2000 个字符。", "type": "string", "minLength": 1, "maxLength": 2000 },
    "color": { "description": "sRGB 颜色，小写十六进制。", "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "sizeClass": { "description": "车辆尺寸档位。", "enum": ["small", "medium", "large", "extra_large", "titan"] },
    "material": {
      "description": "表现材质类别，见美术 02。",
      "enum": ["painted_metal", "bare_metal", "concrete", "stone_soil", "glass", "polymer_rubber", "organic"]
    },
    "facilityTag": {
      "description": "设施兼容标签，取值由代码提供。暂时只列出示例用到的标签，Demo 的完整清单由 Demo 内容与资产清单（issue #283）确定。",
      "enum": ["agriculture", "extraction", "metallurgy", "building_materials", "light_industry", "chemical", "food_processing", "assembly", "electronics", "recovery"]
    },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "positiveInt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "propulsion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traction", "rated_speed"],
      "properties": {
        "traction": { "$ref": "#/$defs/positiveNumber" },
        "rated_speed": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "control": { "type": "object", "additionalProperties": false },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity"],
      "properties": {
        "capacity": { "$ref": "#/$defs/positiveInt" }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_rate"],
      "properties": {
        "work_rate": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_rate"],
      "properties": {
        "work_rate": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_rate", "max_size_class"],
      "properties": {
        "work_rate": { "$ref": "#/$defs/positiveNumber" },
        "max_size_class": { "$ref": "#/$defs/sizeClass" }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output"],
      "properties": {
        "output": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["damage", "interval"],
      "properties": {
        "damage": { "$ref": "#/$defs/positiveInt" },
        "interval": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "platform": { "description": "没有参数；每个完好的部件提供一个站台。", "type": "object", "additionalProperties": false },
    "functionalBehaviors": {
      "description": "功能性行为的核心参数，以行为类型为键。体素和功能复合体共用。",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "propulsion": { "$ref": "#/$defs/propulsion" },
        "control": { "$ref": "#/$defs/control" },
        "storage": { "$ref": "#/$defs/storage" },
        "production": { "$ref": "#/$defs/production" },
        "extraction": { "$ref": "#/$defs/extraction" },
        "construction": { "$ref": "#/$defs/construction" },
        "power": { "$ref": "#/$defs/power" },
        "weapon": { "$ref": "#/$defs/weapon" },
        "platform": { "$ref": "#/$defs/platform" }
      }
    }
  }
}
