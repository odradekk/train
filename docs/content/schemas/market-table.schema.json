{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/market-table.schema.json",
  "title": "市场表（<local id>.market-table.json）",
  "description": "首个切片的临时格式，字段说明见 docs/content/market-table.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "simulation"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "$ref": "common.schema.json#/$defs/localId" },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goods"],
      "properties": {
        "goods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["voxel", "sensitivity", "min_price", "max_price"],
            "properties": {
              "voxel": { "$ref": "common.schema.json#/$defs/definitionRef" },
              "sensitivity": { "type": "number", "minimum": 0 },
              "min_price": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
              "max_price": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
            }
          }
        }
      }
    }
  }
}
