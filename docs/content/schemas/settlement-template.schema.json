{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/odradekk/train/master/docs/content/schemas/settlement-template.schema.json",
  "title": "聚居地模板（<local id>.settlement-template.json）",
  "description": "字段说明见 docs/content/settlement-template.md。引用的类别、建筑能否放进地块、地块编号等由加载器检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "settlement_type", "scene_model", "plots", "display"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/localId" },
    "settlement_type": { "$ref": "common.schema.json#/$defs/definitionRef" },
    "weight": { "$ref": "common.schema.json#/$defs/positiveInt", "default": 1 },
    "scene_model": { "$ref": "common.schema.json#/$defs/definitionRef" },
    "plots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plot" }
    },
    "founding": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plot", "building"],
        "properties": {
          "plot": { "$ref": "common.schema.json#/$defs/positiveInt" },
          "building": { "$ref": "common.schema.json#/$defs/definitionRef" }
        }
      }
    },
    "inventory": {
      "type": "array",
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["voxel", "quantity"],
            "properties": {
              "voxel": { "$ref": "common.schema.json#/$defs/definitionRef" },
              "quantity": { "$ref": "common.schema.json#/$defs/positiveInt" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["blueprint", "quantity"],
            "properties": {
              "blueprint": { "$ref": "common.schema.json#/$defs/definitionRef" },
              "quantity": { "$ref": "common.schema.json#/$defs/positiveInt" }
            }
          }
        ]
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "description": { "$ref": "common.schema.json#/$defs/description" }
      }
    }
  },
  "$defs": {
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "size", "at"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "size": { "enum": ["small", "medium", "large", "station"] },
        "at": { "$ref": "blueprint.schema.json#/$defs/position" },
        "orientation": { "enum": ["px_py", "pz_py", "nx_py", "nz_py"], "default": "px_py" },
        "building": { "$ref": "common.schema.json#/$defs/definitionRef" }
      }
    }
  }
}
