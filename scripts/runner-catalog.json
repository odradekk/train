{
  "feedback": "已登记的 App 检查在同一次调用里只构建一次游戏工程、只导入一次，选择导出检查时再共享一次 Windows 导出；各检查串行执行，并分别使用隔离的用户数据目录。",
  "checks": [
    {
      "id": "godot.logging-smoke",
      "family": "headless",
      "scopes": ["logging"],
      "requirements": ["godot"],
      "group": "godot-logging",
      "script": "scripts/checks/run-app-check.ps1",
      "arguments": ["-Check", "logging", "-OutputDirectory", "{output}"],
      "claim": "engine-observation",
      "needsImport": true,
      "needsGameBuild": true,
      "timeoutSeconds": 60,
      "timeoutReason": "真实 Godot 验证前台与后台日志排空及 logger 释放；60 秒只作为冷启动卡住上限。"
    },
    {
      "id": "godot.content-smoke",
