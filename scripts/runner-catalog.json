{
  "feedback": "五项 App 检查在同一次调用里只构建一次游戏工程、只导入一次，选择导出检查时再共享一次 Windows 导出；各检查串行执行，并分别使用隔离的用户数据目录。",
  "checks": [
    {
      "id": "godot.logging-smoke",
      "family": "headless",
      "scopes": ["logging"],
      "requirements": ["godot"],
      "group": "godot-logging",
      "script": "scripts/checks/run-app-check.ps1",
      "arguments": ["-Check", "logging", "-OutputDirectory", "{output}"],
      "claim": "engine-observation",
      "needsImport": true,
      "needsGameBuild": true,
      "timeoutSeconds": 60,
      "timeoutReason": "真实 Godot 验证前台与后台日志排空及 logger 释放；60 秒只作为冷启动卡住上限。"
    },
    {
      "id": "godot.content-smoke",
      "family": "headless",
      "scopes": ["content"],
      "requirements": ["godot"],
      "group": "godot-content",
      "script": "scripts/checks/run-app-check.ps1",
      "arguments": ["-Check", "content", "-OutputDirectory", "{output}"],
      "claim": "engine-observation",
      "needsImport": true,
      "needsGameBuild": true,
      "needsContentInput": true,
      "timeoutSeconds": 60,
      "timeoutReason": "真实 Godot 加载两份隔离内容源并验证重载和移除；60 秒只作为冷启动卡住上限。"
    },
    {
      "id": "godot.main-menu",
      "family": "headless",
      "scopes": ["menu"],
      "requirements": ["godot"],
      "group": "godot-main-menu",
      "script": "scripts/checks/run-app-check.ps1",
      "arguments": ["-Check", "main-menu", "-OutputDirectory", "{output}"],
      "claim": "engine-observation",
      "needsImport": true,
      "needsGameBuild": true,
      "timeoutSeconds": 60,
      "timeoutReason": "真实 Godot 验证主菜单仅有退出动作并通过实际信号退出；60 秒只作为冷启动卡住上限。"
    },
    {
      "id": "godot.content-export-smoke",
      "family": "headless",
      "scopes": ["content"],
      "requirements": ["godot", "export"],
      "group": "windows-export-content",
      "script": "scripts/checks/run-app-check.ps1",
      "arguments": ["-Check", "content-export", "-OutputDirectory", "{output}", "-ExecutablePath", "{exportBinary}"],
      "claim": "export-runtime",
      "needsImport": true,
      "needsGameBuild": true,
      "needsExport": true,
      "timeoutSeconds": 60,
      "timeoutReason": "运行共享 Windows 导出并验证内置内容；60 秒只作为运行时卡住上限。"
    },
    {
      "id": "godot.mods-export-smoke",
      "family": "headless",
      "scopes": ["content"],
      "requirements": ["godot", "export"],
      "group": "windows-export-mods",
      "script": "scripts/checks/run-app-check.ps1",
      "arguments": ["-Check", "mods-export", "-OutputDirectory", "{output}", "-ExecutablePath", "{exportBinary}"],
      "claim": "export-runtime",
      "needsImport": true,
      "needsGameBuild": true,
      "needsExport": true,
      "timeoutSeconds": 60,
      "timeoutReason": "运行共享 Windows 导出并验证空模组根目录；60 秒只作为运行时卡住上限。"
    }
  ],
  "inventory": [
    {
      "id": "harness.app-check",
      "entry": "pwsh -NoProfile -File scripts/checks/run-app-check.tests.ps1",
      "contract": "用假进程检查五项 App 自检的参数、标记、真实退出码、缺环境和带空格路径处理。不运行真实游戏，也不复制游戏断言。",
      "boundary": "PowerShell 7 和假的本机程序。真实 Godot、导出和 Windows 运行时由统一入口的对应检查证明。",
      "destination": "保留为统一 App 检查脚本的编排测试。",
      "status": "support-harness",
      "durationStatus": "unmeasured",
      "claim": "orchestration",
      "requirements": []
    },
    {
      "id": "tool.invoke-hidden-process",
