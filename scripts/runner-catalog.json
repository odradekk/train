      "claim": "export-runtime",
      "needsImport": true,
      "needsGameBuild": true,
      "needsExport": true,
      "timeoutSeconds": 60,
      "timeoutReason": "运行共享 Windows 导出并验证内置内容；60 秒只作为运行时卡住上限。"
