; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is committed so the Windows tracer can be built.

config_version=5

[application]

config/name="Train MVP"
config/description="Archived MVP validation build"
config/version="0.0.0-mvp"
run/main_scene="res://App/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="TrainMvp"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
