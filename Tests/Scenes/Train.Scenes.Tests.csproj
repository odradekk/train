<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <IsPackable>false</IsPackable>
    <RootNamespace>Train.Scenes.Tests</RootNamespace>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Scenes/Train.Scenes.csproj" />
    <ProjectReference Include="../ContractSupport/Core/Train.Core.ContractSupport.csproj" />
    <ProjectReference Include="../ContractSupport/Content/Train.Content.ContractSupport.csproj" />
    <ProjectReference Include="../ContractSupport/Scenes/Train.Scenes.ContractSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../builtin/core/resources/settlement-templates/*.settlement-template.json" LinkBase="builtin/core/resources/settlement-templates" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../builtin/core/resources/blueprints/*-ground.blueprint.json" LinkBase="builtin/core/resources/blueprints" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
