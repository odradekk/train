<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GodotProjectDir>$(MSBuildProjectDirectory)/../../</GodotProjectDir>
    <OutputPath>$(GodotProjectDir).godot/mono/temp/bin/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Bootstrap/**" />
    <CompilerVisibleProperty Include="GodotProjectDir" />
    <ProjectReference Include="../../Train.csproj" />
    <PackageReference Include="Chickensoft.GoDotTest" Version="2.0.47" />
    <PackageReference Include="Chickensoft.GodotTestDriver" Version="3.1.83" />
  </ItemGroup>
</Project>
